# 统一 LF 行尾：项目部署目标为 Linux 服务器（CRLF 会导致 shell 脚本 bad interpreter）
* text=auto eol=lf

# 明确按文本处理（避免被误判为二进制而跳过归一化）
*.py   text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.csv  text eol=lf
*.sh   text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.txt  text eol=lf
